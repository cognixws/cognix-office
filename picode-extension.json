{
  "id": "office",
  "formerly": [
    "picode-office"
  ],
  "name": "Office files",
  "version": "0.4.0",
  "apiVersion": 1,
  "publisher": "COGNIX[WS]",
  "description": "Spreadsheets, Word documents, and presentations as artifacts: publish or import .xlsx, .docx, and .pptx files and edit them in place with versioned autosave.",
  "ui": {
    "pages": [
      {
        "id": "sheet",
        "title": "Spreadsheet",
        "path": "ui/sheet.html"
      },
      {
        "id": "doc",
        "title": "Word document",
        "path": "ui/doc.html"
      },
      {
        "id": "deck",
        "title": "Presentation",
        "path": "ui/deck.html"
      }
    ]
  },
  "contributes": {
    "artifactKinds": [
      {
        "kind": "xlsx",
        "title": "Spreadsheet",
        "types": [
          "xlsx"
        ],
        "page": "sheet",
        "entryContains": [
          "[Content_Types].xml"
        ]
      },
      {
        "kind": "docx",
        "title": "Word document",
        "types": [
          "docx"
        ],
        "page": "doc",
        "entryContains": [
          "[Content_Types].xml",
          "word/document.xml"
        ]
      },
      {
        "kind": "pptx",
        "title": "Presentation",
        "types": [
          "pptx"
        ],
        "page": "deck",
        "entryContains": [
          "[Content_Types].xml",
          "ppt/presentation.xml"
        ]
      }
    ]
  }
}
